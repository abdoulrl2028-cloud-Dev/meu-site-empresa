<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
  <defs>
    <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0066cc;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0052a3;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Círculo de fundo -->
  <circle cx="100" cy="100" r="95" fill="url(#logoGrad)"/>
  
  <!-- Texto -->
  <text x="100" y="70" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">MEU</text>
  <text x="100" y="120" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">EMPRESA</text>
  
  <!-- Símbolo decorativo -->
  <path d="M 70 55 Q 100 40 130 55" stroke="white" stroke-width="3" fill="none" stroke-linecap="round"/>
</svg>
